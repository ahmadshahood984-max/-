rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny to ensure security of other collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for school live data sync keys
    // Since the app uses client-side password verification rather than Firebase Auth,
    // this collection must be publicly accessible for reads and writes to sync across devices.
    match /school_live_data/{key} {
      allow read, write: if true;
    }

    // Rules for direct teacher-submitted and director-approved grade reports
    match /grade_reports/{reportId} {
      allow read, write: if true;
    }

    // Startup connection check document
    match /test/connection {
      allow read: if true;
    }

    // Rules for consolidated single-document student grades (on-demand direct getDoc by studentId)
    match /students_grades/{studentId} {
      allow read, write: if true;
    }

    // Rules for scoped student grades collection (on-demand query by studentId)
    match /student_grades/{gradeId} {
      allow read, write: if true;
    }

    // Rules for FCM registration tokens
    match /fcm_tokens/{parentId} {
      allow read, write: if true;
    }

    // Rules for notifications
    match /notifications/{docId} {
      allow read, write: if true;
    }

    // Rules for system usage tracking
    match /system_usage/{dateId} {
      allow read, write: if true;
    }

    // Rules for centralized Firestore consumption tracking (system_stats/consumption)
    match /system_stats/{statId} {
      allow read, write: if true;
    }
  }
}
